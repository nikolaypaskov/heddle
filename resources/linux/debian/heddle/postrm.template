#!/usr/bin/env bash

# The action ("remove", "purge", "upgrade", ...) is passed as the first argument
# to the postrm script. Nothing here is conditional on it: this package writes no
# apt source and no keyring, so there is nothing extra for a purge to clean up.
rm -f /usr/bin/@@BINARY_NAME@@

# Make sure the system forgets the newly-uninstalled desktop file.
if hash update-desktop-database 2>/dev/null; then
	update-desktop-database
fi

exit 0
