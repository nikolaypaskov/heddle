#!/usr/bin/env bash

# There is no symlink management here, deliberately.
#
# /usr/bin/@@BINARY_NAME@@ is shipped in the package's DATA ARCHIVE, so dpkg owns
# it: it conflict-checks the path at unpack time, records it under `dpkg -L`, and
# removes it on uninstall -- and only while the record still points at us.
#
# This script used to `rm -f` that path and re-create it. dpkg therefore knew
# nothing about the link: no conflict check, no ownership record, and a matching
# unconditional `rm -f` in postrm that deleted whatever was at the path on
# removal, including another package's file. See the block that creates it in
# script/linux/bundle_deb.
#
# The link name is the BINARY name, which for this channel is also the package
# name and also the desktop entry's Exec=
# (app/channels/oss/dev.heddle.Heddle.desktop). If those three ever drift apart,
# the launcher entry stops working silently.

# Make sure the system incorporates the newly-installed desktop file.
if hash update-desktop-database 2>/dev/null; then
	update-desktop-database
fi

# NO apt repository is configured here, and none should be.
#
# The other channels append resources/linux/debian/common/postinst.repo.template
# at this point, which installs a package-signing key and writes an apt source.
# This fork publishes to GitHub Releases and hosts no apt repository, so writing
# a source list would leave every user with a source that 404s on each
# `apt update` -- a worse outcome than having no repository at all. See the
# CONFIGURE_PACKAGE_REPO branch in script/linux/bundle_deb.

exit 0
