#!/usr/bin/env bash
# Gate the GUI: it must still COMPILE, and its commercial UI surface must only ever SHRINK.
#
# Why this exists: no other gate enables the `gui` feature. Host clippy, the test suite and the
# wasm gate all build the `warp` lib and `warp_tui`. The `heddle` bin -- the actual GUI app --
# is built with `gui` and was, until this script, never compiled by any check at all.
#
# That blind spot was not theoretical. Two defects lived in it undetected:
#
#   1. script/macos/bundle's oss channel referenced `warp-oss`, a bin target that has not
#      existed since the rename, so the GUI could not be bundled. Nobody noticed because
#      nobody ever built it.
#   2. The GUI still renders upstream's commercial UI -- a sign-in flow, a Warp Drive panel,
#      "Log out", "Upgrade plan", an entire app/src/billing module. The de-commercialization
#      slices removed backend plumbing; view code was never audited, because nothing looked.
#
# A feature that is never compiled cannot report anything, and `dead_code` does not see across
# a feature gate. So the check has to be explicit.
#
#   ./script/heddle/gui-surface-gate                     # compile + surface comparison
#   ./script/heddle/gui-surface-gate --surfaces-only     # skip the build
#   ./script/heddle/gui-surface-gate --update            # re-record after REMOVING surfaces
#   ./script/heddle/gui-surface-gate --update --allow-additions   # deliberately baseline new ones
#
# Exit status is a contract, and every path honours it:
#   0  the surface matches the baseline
#   1  surfaces were ADDED, or the GUI does not compile
#   2  infrastructure failure -- the check could not be performed at all
#   3  surfaces were REMOVED and the baseline is now stale
#
# The baseline is expected to SHRINK as the sweep proceeds. A removal is not a failure; it
# means the baseline must be re-recorded IN THE SAME CHANGE, enforced by exit 3 rather than
# left to discipline. While a baseline still lists something that has been deleted, that thing
# can be reintroduced up to the recorded count for free.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
BASELINE="$REPO_ROOT/script/heddle/gui-surfaces.baseline"

# Kept identical to the oss branch of script/macos/bundle. If that feature list changes, this
# one must change with it, or the gate stops checking what actually ships.
GUI_FEATURES="release_bundle,extern_plist,gui,nld_classifier_v3,nld_heuristic_v2"

# Scan the WHOLE repository, not a curated list of view directories.
#
# An earlier version named three roots and required each to exist with a floor of ten .rs
# files. That still failed open: a root can keep ten unrelated files while its GUI code moves
# somewhere unlisted, the aggregate floor still clears, the new location is never scanned, and
# the apparent removals invite a --update that blesses the blindness. Any curated location list
# has that hole, and the sweep is going to be MOVING code, so the hole would be open exactly
# when it matters most. Scanning everything removes the class rather than tightening the floor.
SCAN_EXCLUDES=(--exclude-dir=target --exclude-dir=.git --exclude-dir=node_modules)

# Floor that catches a scan which silently covered almost nothing. The tree holds ~3740 .rs
# files, so this survives very large deletions while refusing an empty or truncated walk.
MIN_RS_TOTAL=2000

# Two classes of marker, because one rule cannot serve both.
#
# ANCHORED -- generic words that are only meaningful as UI when they open a string literal.
# Without the leading-quote anchor, `login` matches `parsed["owner"]["login"]` in
# app/src/util/git.rs, a GitHub API field and not a sign-in button. Such a row could never be
# "removed", so it would sit in the baseline forever as permanent noise.
#
# UNANCHORED -- phrases distinctive enough to be commercial UI wherever they appear, including
# mid-sentence. The first version of this gate anchored everything and therefore missed
# "Compare plans", "Manage billing", "Your team has run out of credits. Purchase more credits
# to continue." and "{credits} free cloud agent credits" -- real rendered text, invisible to a
# rule that only looked at the first word of a literal.
# Matching is CASE-INSENSITIVE. Case sensitivity was a silent false-negative source: the tree
# renders "Sign Up" (app/src/terminal/view/inline_banner/anonymous_user_ai_sign_up.rs) and
# lowercase "upgrade..." copy, neither of which matched a list written as "Sign up"/"Upgrade".
# Three real strings -- "Create an account", "Sign Up", "View plans" -- were present in the
# tree and absent from the baseline, so the gate reported PASS over live commercial UI.
#
# The vocabulary is derived from the actual copy in the known commercial modules
# (app/src/billing, app/src/auth, cloud_agent_capacity_modal, share_modal/denied_body,
# inline_banner/anonymous_user_ai_sign_up) rather than guessed, which is how the phrasing
# variants above were found.
ANCHORED='Sign in|Sign out|Sign up|Log in|Log out|Login|Logout|Upgrade|Subscription|Subscribe|Billing|Create account|Create an account|Manage plan|Your account|Refer a friend|Purchase'
UNANCHORED='Warp Drive|Compare plans|Manage billing|View plans|Pro plan|Paid plan|Business plan|Team plan|free trial|AI credits|more credits|free credits|out of credits|cloud agent credits|upgrade_url'
PATTERN="(\"($ANCHORED)|($UNANCHORED))"

RUN_BUILD=true
MODE=compare
ALLOW_ADDITIONS=false

usage() {
  echo "usage: $0 [--surfaces-only] [--update [--allow-additions]]" >&2
}

while (($#)); do
  case "$1" in
    --surfaces-only)   RUN_BUILD=false ;;
    --update)          MODE=update; RUN_BUILD=false ;;
    --allow-additions) ALLOW_ADDITIONS=true ;;
    *) usage; exit 2 ;;
  esac
  shift
done

if [[ "$ALLOW_ADDITIONS" == true && "$MODE" != update ]]; then
  echo "error: --allow-additions is only meaningful with --update." >&2
  exit 2
fi

# Every infrastructure failure funnels through here so none of them can inherit an arbitrary
# status. `mktemp`, `cp`, `sort` and `comm` all return 1 on failure, which is indistinguishable
# from "surfaces were added" -- the difference between a real regression and a broken tool.
die_infra() {
  echo "error: $*" >&2
  echo "       This is an infrastructure failure, not a result. Nothing was verified." >&2
  exit 2
}

##############################
## Part 1: does it compile? ##
##############################

if [[ "$RUN_BUILD" == true ]]; then
  echo "Checking the GUI compiles (--bin heddle --features $GUI_FEATURES)..."
  raw="$(mktemp)" || die_infra "mktemp failed"
  trap 'rm -f "${raw:-}"' EXIT

  set +e
  ( cd "$REPO_ROOT" && cargo check -p warp --bin heddle --features "$GUI_FEATURES" ) > "$raw" 2>&1
  status=$?
  set -e

  # Distinguish "rustc rejected the code" from "cargo never ran". Both exit non-zero, and
  # conflating them reports a compile failure that does not exist -- which is how this script
  # behaved on its first run: with no ~/.cargo/bin on PATH the subshell exited 127 and the gate
  # announced "the GUI does not compile" while printing no errors, because there were none. A
  # tool that blames the code for its own breakage sends you hunting a defect that isn't there.
  if ! grep -qE '^(    Finished|error: could not compile)' "$raw"; then
    echo "error: the GUI check did not complete a Rust compilation (cargo exit $status)." >&2
    echo "       This is an infrastructure failure, not a compile error. Last lines:" >&2
    tail -5 "$raw" | sed 's/^/       /' >&2
    echo >&2
    echo "       If cargo was not found, put ~/.cargo/bin on PATH." >&2
    exit 2
  fi

  if [[ $status -ne 0 ]]; then
    echo "FAIL: the GUI does not compile." >&2
    grep -E '^error' "$raw" | head -20 >&2
    echo >&2
    echo "The lib and TUI can be green while this is broken -- they do not enable \`gui\`." >&2
    exit 1
  fi
  echo "PASS: the GUI compiles."
fi

#######################################
## Part 2: the commercial UI surface ##
#######################################

# Fail closed on a scan that did not really walk the tree. With the whole repository in scope
# there is no root to rename, so the only remaining way to under-scan is for the walk itself to
# cover almost nothing -- a wrong working directory, a broken checkout, an exclude that ate too
# much. A near-empty walk would read every baseline row as "removed" and invite a --update that
# permanently blinds the gate, so it must be fatal rather than merely quiet.
verify_tree() {
  cd "$REPO_ROOT"
  local total
  total="$(find . -name '*.rs' -not -path './target/*' -not -path './.git/*' | wc -l | tr -d ' ')" \
    || die_infra "find failed while counting .rs files"
  if (( total < MIN_RS_TOTAL )); then
    die_infra "only $total .rs files found in the tree (expected >= $MIN_RS_TOTAL)"
  fi
}

# `-o` records file + the offending literal rather than the whole line, so rewording the
# surrounding code does not read as a change while moving it to another file does. No `-n`, so
# there are no line numbers to strip -- an earlier version stripped them with a
# `s/:[0-9]+:/:/` substitution that would corrupt any path containing `:<digits>:`.
#
# Sorted under LC_ALL=C, and compared under it too: `comm` demands both inputs be ordered by
# the SAME collation, and a locale change alone would otherwise manufacture phantom additions.
collect() {
  local out="$1" err gs
  err="$(mktemp)" || die_infra "mktemp failed"
  cd "$REPO_ROOT"

  set +e
  grep -rEoi --include='*.rs' "${SCAN_EXCLUDES[@]}" "$PATTERN" . > "$out.raw" 2>"$err"
  gs=$?
  set -e

  # grep: 0 = matched, 1 = no matches (a legitimate end state for this sweep), >=2 = a real
  # error. The first version ended the pipeline with `|| true`, which swallowed all three
  # alike -- so a grep that could not read the tree produced an empty result that then
  # overwrote the baseline under --update and passed on every run afterwards.
  if (( gs >= 2 )); then
    local detail; detail="$(head -2 "$err")"; rm -f "$err"
    die_infra "grep failed with status $gs: $detail"
  fi
  rm -f "$err"

  LC_ALL=C sort "$out.raw" > "$out" || die_infra "sort failed while normalising the scan"
  rm -f "$out.raw"
}

verify_tree

CURRENT="$(mktemp)" || die_infra "mktemp failed"
trap 'rm -f "$CURRENT" "$CURRENT.raw" "${raw:-}"' EXIT
collect "$CURRENT"

if [[ ! -f "$BASELINE" ]]; then
  # A missing baseline is the --update rubber stamp in another costume: delete the file, run
  # --update, and every surface currently in the tree is blessed at once with exit 0 -- no
  # additions reported, because there was nothing to compare against. Bootstrapping is a
  # legitimate but rare act, so it has to be said out loud, exactly like baselining additions.
  if [[ "$MODE" == update && "$ALLOW_ADDITIONS" == true ]]; then
    cp "$CURRENT" "$BASELINE" || die_infra "could not write $BASELINE"
    echo "Bootstrapped $(wc -l < "$BASELINE" | tr -d ' ') commercial UI surfaces to $BASELINE"
    exit 0
  fi
  if [[ "$MODE" == update ]]; then
    echo "FAIL: no baseline at $BASELINE, so --update would bless every surface in the tree" >&2
    echo "      at once without reporting a single addition. If that is really what you want," >&2
    echo "      say so: --update --allow-additions" >&2
    exit 1
  fi
  echo "error: no baseline at $BASELINE. Bootstrap one with --update --allow-additions." >&2
  exit 2
fi

# A baseline that is not sorted in this collation makes `comm` emit nonsense, and the nonsense
# looks exactly like added surfaces -- exit 1, a regression that never happened.
LC_ALL=C sort -c "$BASELINE" 2>/dev/null \
  || die_infra "$BASELINE is not sorted under LC_ALL=C; re-record it with --update"

ADDED="$(LC_ALL=C comm -13 "$BASELINE" "$CURRENT")" || die_infra "comm failed comparing to the baseline"
REMOVED="$(LC_ALL=C comm -23 "$BASELINE" "$CURRENT")" || die_infra "comm failed comparing to the baseline"

if [[ "$MODE" == update ]]; then
  # --update must not be a rubber stamp. Recording whatever happens to be present would let
  # anyone add a sign-in button and legitimise it in the same breath, which defeats the only
  # purpose this gate has. Removals re-record freely; additions demand saying so out loud.
  if [[ -n "$ADDED" && "$ALLOW_ADDITIONS" == false ]]; then
    echo "FAIL: --update refuses to baseline ADDED commercial UI surfaces:" >&2
    echo "$ADDED" | sed 's/^/  + /' >&2
    echo >&2
    echo "Removals re-record without ceremony; additions do not. If these are genuinely" >&2
    echo "wanted, say so explicitly: --update --allow-additions" >&2
    exit 1
  fi
  cp "$CURRENT" "$BASELINE" || die_infra "could not write $BASELINE"
  echo "Recorded $(wc -l < "$BASELINE" | tr -d ' ') commercial UI surfaces to $BASELINE"
  exit 0
fi

if [[ -n "$REMOVED" ]]; then
  echo "These commercial UI surfaces are GONE relative to the baseline:"
  echo "$REMOVED" | sed 's/^/  - /'
  echo
fi

if [[ -n "$ADDED" ]]; then
  echo "FAIL: this change adds commercial UI surfaces that are not in the baseline:" >&2
  echo "$ADDED" | sed 's/^/  + /' >&2
  echo >&2
  echo "Heddle has no account and no vendor backend, so there is nothing for a sign-in," >&2
  echo "a Drive panel or an upgrade prompt to talk to. If this text is genuinely needed," >&2
  echo "record it deliberately with --update --allow-additions." >&2
  exit 1
fi

if [[ -n "$REMOVED" ]]; then
  echo "FAIL: the baseline is now stale. Until it is re-recorded, those surfaces could be" >&2
  echo "      reintroduced up to the recorded count without failing this gate." >&2
  echo "      Re-record in THIS change: ./script/heddle/gui-surface-gate --update" >&2
  exit 3
fi

echo "PASS: commercial UI surface matches the baseline ($(wc -l < "$BASELINE" | tr -d ' ') entries)."
