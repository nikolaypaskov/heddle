#!/bin/bash
#
# Verifies that a built Heddle binary contains NO Warp first-party endpoints,
# credentials, or telemetry destinations.
#
# WHAT THIS DOES AND DOES NOT PROVE
#
# This is a regression tripwire, NOT proof that the binary cannot contact Warp.
# It is cheap, deterministic, and catches the reintroduction of a hardcoded
# endpoint — which is exactly the drift a fork tracking a fast-moving upstream
# needs to catch. It does not prove absence of egress:
#
#   - An endpoint can be assembled at runtime from fragments, read from user
#     configuration, or arrive in a redirect, and no literal appears here.
#   - A user can always type `curl app.warp.dev` into the terminal. No property
#     of this binary can prevent that, and it would be dishonest to imply
#     otherwise.
#
# The defensible claim is therefore scoped: *Heddle's own code initiates no
# connection to Warp's infrastructure.* Supporting that claim needs this scan
# PLUS syscall- or namespace-level runtime tracing across startup, onboarding,
# agents, updates and shutdown. Treat a PASS here as "no known regression",
# never as "verified silent".
#
# Usage: script/heddle/verify-no-warp-endpoints [path-to-binary]
#        defaults to target/debug/heddle-tui
#
# Exit codes: 0 = clean, 1 = forbidden strings found, 2 = inconclusive.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/../.. && pwd)"
cd "${REPO_ROOT}"

BINARY="${1:-target/debug/heddle-tui}"

if [[ ! -f "${BINARY}" ]]; then
    echo "INCONCLUSIVE: binary not found at ${BINARY}"
    echo "Build it first: cargo build -p warp_tui --bin heddle-tui"
    exit 2
fi

# Refuse to scan a stale artifact.
#
# A failed build leaves the previous binary in place, so scanning it reports on
# code that is no longer the source. That has already happened once here: a
# build failed, and the scan dutifully analysed an hours-old binary as though it
# were the current one. A verification tool that can describe an artifact which
# does not reflect the source is worse than no tool.
NEWER_SOURCES="$(find app/src crates -name '*.rs' -newer "${BINARY}" -print -quit 2>/dev/null || true)"
if [[ -n "${NEWER_SOURCES}" ]]; then
    echo "INCONCLUSIVE: ${BINARY} is older than the sources."
    echo "At least one file changed after it was built: ${NEWER_SOURCES}"
    echo "Rebuild before scanning: cargo build -p warp_tui --bin heddle-tui"
    exit 2
fi

# Strings that must never appear in a Heddle binary. Each is a first-party Warp
# endpoint, credential, or telemetry destination.
FORBIDDEN=(
    # Every warp.dev host, not an enumerated list of subdomains. An earlier
    # version forbade "www.warp.dev" and a bare "https://warp.dev/privacy" link
    # sailed straight through it. Forbidding the apex domain removes that whole
    # class of miss -- including documentation links, which have all been
    # replaced so the claim can be unconditional.
    "warp.dev"
    "dataplane.rudderstack.com"
    "rudderlabs.com"
    # Warp-branded embedded assets. rust_embed stores each asset's relative
    # PATH as a string literal, so a branded PNG/font is detectable by its path
    # even though its pixels are not. A string-only scan misses these -- Codex
    # found a Warp logomark banner and a warpLogo glyph shipping this way. The
    # standalone build excludes the async/ imagery; these entries fail the scan
    # if any branded asset is ever re-embedded.
    "openwarp_launch_banner"
    "oz_agent_management"
    "oz_agent_automations"
    "oz_cloud_agents"
    "oz_launch_credits"
    "customize_warpdrive"
    "warp_install_image"
    "warpLogo"
    "warp-loading"  # Warp's animated logomark frames; replaced with a neutral spinner
    "svg/oz-"       # any Oz-branded bundled vector asset path
    # User-facing branded PROSE (help text, product taglines). This class is not
    # exhaustively greppable, but the most prominent phrases are pinned so they
    # cannot silently return. Codex/local-run found "The Oz CLI is a tool"
    # shipping in the binary's --help.
    "The Oz CLI is a tool"
    "orchestration platform for cloud agents"
    "Log in to Warp"
)

# Patterns, not literals. Matched with `grep -aE`.
#
# The Firebase auth API key used to sit in FORBIDDEN as a literal, which meant this
# scanner -- a file in a public repository -- contained the very credential it exists
# to forbid. GitHub secret scanning flagged it, correctly. Forbidding the SHAPE of a
# Google API key instead is both safer and strictly stronger: it catches that key, any
# rotation of it, and any other Google credential that is ever linked in, while this
# file stores no secret at all.
FORBIDDEN_PATTERNS=(
    'AIza[0-9A-Za-z_-]{35}'   # any Google API key, including Warp's Firebase auth key
)

# Scan RAW BYTES with grep, not `strings`.
#
# macOS ships the cctools `strings`, which parses Mach-O load commands and only
# scans known sections -- even with `-a`. Verified here: appending
# "CANARYoz.warp.devCANARY" to a copy of the binary grew the file, `grep -a`
# found it, and `strings -a` did not, reporting an identical line count. A
# scanner that can miss planted bytes cannot certify their absence.
#
# `grep -a` treats the binary as text and matches literal byte sequences, so it
# cannot miss a hardcoded endpoint regardless of which section it lands in.

# Validate the instrument before trusting a clean result: a known-present marker
# must be found, or grep is not reading the file as expected and every pattern
# would trivially "pass".
# A string guaranteed present in any Heddle binary (GUI or TUI). Used to prove
# the scanner is actually reading content before trusting a clean result.
SENTINEL="Heddle"
if ! LC_ALL=C grep -aqF -- "${SENTINEL}" "${BINARY}"; then
    echo "INCONCLUSIVE: sentinel '${SENTINEL}' not found in ${BINARY}."
    echo "The scan cannot be trusted; grep is not matching content it should."
    exit 2
fi

echo "Scanning ${BINARY} ($(stat -f%z "${BINARY}" 2>/dev/null || stat -c%s "${BINARY}") bytes, raw)..."

FOUND=0
for needle in "${FORBIDDEN[@]}"; do
    # grep exits 1 when it finds nothing. Under `set -e` + `pipefail` that
    # aborts the whole script before it can report anything -- which reads as a
    # FAIL but is actually a crash. Neutralise grep's exit status explicitly.
    count="$( { LC_ALL=C grep -aoF -- "${needle}" "${BINARY}" || true; } | wc -l | tr -d ' ')"
    if [[ "${count}" -gt 0 ]]; then
        echo "  FORBIDDEN: ${needle} (${count} occurrence(s))"
        FOUND=1
    fi
done

for pattern in "${FORBIDDEN_PATTERNS[@]}"; do
    count="$( { LC_ALL=C grep -aoE -- "${pattern}" "${BINARY}" || true; } | wc -l | tr -d ' ')"
    if [[ "${count}" -gt 0 ]]; then
        # Deliberately does not echo the match: printing a found credential into CI
        # logs would re-publish it in a second place.
        echo "  FORBIDDEN PATTERN: ${pattern} (${count} match(es), value withheld)"
        FOUND=1
    fi
done

if [[ "${FOUND}" -ne 0 ]]; then
    echo
    echo "FAIL: Heddle binary contains Warp first-party endpoints or credentials."
    echo "The build is NOT endpoint-free. Find the reference with:"
    echo "  grep -rn '<the string>' app crates --include='*.rs'"
    exit 1
fi

echo "PASS: no Warp endpoints, credentials, or telemetry destinations found."
