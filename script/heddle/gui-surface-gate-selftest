#!/usr/bin/env bash
# Prove gui-surface-gate CAN fail, before trusting it when it passes.
#
# A verification tool that cannot distinguish "checked and clean" from "did not really check"
# converts uncertainty into false confidence. That has bitten this project repeatedly, and it
# bit this very gate: its first fail-closed self-test copied the script to /tmp and ran it
# there. But the script derives REPO_ROOT from its own location, so the copy resolved REPO_ROOT
# to `/`, found no scan roots, and exited 2 -- the expected status, for entirely the wrong
# reason. An UNMODIFIED copy would have "passed" that test identically. It proved nothing.
#
# Four rules follow, and every case here obeys them:
#   1. Assert the exact status AND the expected message. Any-nonzero would let an unrelated
#      failure pose as a working canary on a gate that is broken in some other way.
#   2. Every negative case needs a POSITIVE CONTROL proving the harness is sound -- that the
#      case fails for the reason claimed rather than by construction.
#   3. Test what the gate actually DOES, not a proxy for it. Raising a file-count floor tests
#      the floor; it says nothing about whether the collector reads the whole tree.
#   4. Never create, overwrite or delete a path this script did not allocate itself.
#
# Mutated copies live in script/heddle/ so REPO_ROOT still resolves to the repository.

set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)" || {
  echo "could not resolve REPO_ROOT"; exit 2; }
cd "$REPO_ROOT" || { echo "could not cd to $REPO_ROOT"; exit 2; }

GATE=script/heddle/gui-surface-gate
BASELINE=script/heddle/gui-surfaces.baseline

failures=0
backup_ready=false
BACKUP=""
CANARY_DIR=""
REMOTE_DIR=""
ODD_DIR=""
SCRATCH=()

# Restore state even if an assertion aborts mid-run, and delete ONLY what was allocated here.
#
# Fixed scratch paths guarded by a preflight existence check were not good enough: creation and
# deletion happen later, so a concurrent process creating the same name in between would have
# its file overwritten and then removed. Every path below comes from mktemp, which allocates
# atomically, and the trap is installed before the first allocation.
#
# `[[ -s "$BACKUP" ]]` was also wrong as a restore guard: -s is false for an empty file, and an
# empty baseline is precisely the expected END STATE of this sweep. The moment the last
# commercial surface is deleted, that guard would silently decline to restore the baseline it
# had just overwritten. A flag set only after a verified copy is correct, and a failed restore
# must be loud rather than followed by deleting the only backup.
cleanup() {
  [[ -n "$CANARY_DIR" ]] && rm -rf "$CANARY_DIR"
  [[ -n "$REMOTE_DIR" ]] && rm -rf "$REMOTE_DIR"
  [[ -n "$ODD_DIR" ]] && rm -rf "$ODD_DIR"
  local p
  for p in "${SCRATCH[@]:-}"; do [[ -n "$p" ]] && rm -f "$p"; done
  if [[ "$backup_ready" == true ]]; then
    if ! cp "$BACKUP" "$BASELINE"; then
      echo "CRITICAL: could not restore $BASELINE from $BACKUP -- it is NOT being deleted." >&2
      exit 2
    fi
  fi
  [[ -n "$BACKUP" ]] && rm -f "$BACKUP"
}
trap cleanup EXIT

BACKUP="$(mktemp)" || { echo "mktemp failed"; exit 2; }
cp "$BASELINE" "$BACKUP" || { echo "could not back up the baseline"; exit 2; }
backup_ready=true

# mktemp -d because BSD mktemp cannot append a .rs suffix to a template; the directory is
# allocated atomically and the canary file goes inside it. A stray .rs file that no mod.rs
# references is not compiled, so this cannot break the build.
CANARY_DIR="$(mktemp -d app/src/__gate_selftest_XXXXXX)" || { echo "mktemp -d failed"; exit 2; }
CANARY="$CANARY_DIR/canary.rs"

# expect <label> <script> <want_status> <want_text> [args...]
expect() {
  local label="$1" script="$2" want="$3" text="$4"; shift 4
  local out status
  out="$("$script" "$@" 2>&1)"; status=$?
  if [[ "$status" -ne "$want" ]]; then
    echo "  FAIL [$label]: expected exit $want, got $status"
    echo "$out" | sed 's/^/    /' | head -8
    failures=$((failures + 1))
    return
  fi
  if ! printf '%s' "$out" | grep -qF "$text"; then
    echo "  FAIL [$label]: exit $want was right, but not for the expected reason"
    echo "    expected to see: $text"
    echo "$out" | sed 's/^/    /' | head -8
    failures=$((failures + 1))
    return
  fi
  echo "  ok [$label]: exit $status with the expected message"
}

echo "0. CONTROL: a clean tree must PASS, or every negative case below is meaningless."
expect "control-clean" "./$GATE" 0 "PASS: commercial UI surface" --surfaces-only

echo "1. An ADDED commercial surface must be rejected."
printf 'fn canary() -> &%sstatic str { "Upgrade plan" }\n' "'" > "$CANARY"
expect "added-surface" "./$GATE" 1 "adds commercial UI surfaces" --surfaces-only
rm -f "$CANARY"

echo "1b. Case variants must be caught, not just the canonical spelling."
# "Sign Up" was live in the tree and absent from the baseline under a case-sensitive pattern.
printf 'fn canary() -> &%sstatic str { "Sign Up" }\n' "'" > "$CANARY"
expect "case-variant" "./$GATE" 1 "adds commercial UI surfaces" --surfaces-only
rm -f "$CANARY"

echo "1c. MID-LITERAL copy must be caught, not just markers that open a literal."
# The regression test for the anchoring defect. All three of these were rendered in the GUI and
# absent from the baseline, because anchoring only ever saw the first words of a literal.
printf 'fn canary() -> &%sstatic str { "AI features are unavailable for logged-out users. Create an account to use AI." }\n' "'" > "$CANARY"
expect "mid-literal" "./$GATE" 1 "adds commercial UI surfaces" --surfaces-only
rm -f "$CANARY"

echo "1d. EVERY Rust string form must be scanned, not just the easiest one."
# One canary per lexical form. A single easy canary is what let the `"[^"]*"` extractor look
# correct while it was blind to multiline raw strings -- and it silently dropped a real
# baseline row (app/src/workspace/home.rs renders "Warp Drive Objects" from an r#"..."#
# literal) at the same time. Each form gets its own rejection case so a regression in any one
# of them cannot hide behind the others.
form_canary() {  # <label> <rust source>
  printf '%s\n' "$2" > "$CANARY"
  expect "form:$1" "./$GATE" 1 "adds commercial UI surfaces" --surfaces-only
  rm -f "$CANARY"
}
form_canary "multiline-raw" 'const A: &str = r#"
a paragraph that mentions Warp Drive Objects
across several lines
"#;'
form_canary "raw-with-embedded-quote" 'const B: &str = r#"he said "Compare plans" out loud"#;'
form_canary "escaped-quote" 'const C: &str = "an escaped \" quote and then Manage billing";'
form_canary "line-continuation" 'const D: &str = "first line \
second line offering a free trial";'
form_canary "byte-and-raw-prefix" 'const E: &[u8] = br#"Upgrade plan"#;'

echo "1d2. A file the extractor cannot lex must fail closed, not return a partial scan."
# Both of these previously returned a SHORT scan and reported success. Since --update skips
# compilation, that truncated result could be recorded as the baseline, permanently blinding
# the gate to everything the extractor had skipped.
printf 'const A: &str = "Upgrade plan";\n/* never closed\n' > "$CANARY"
expect "unterminated-block-comment" "./$GATE" 2 "unterminated block comment" --surfaces-only
rm -f "$CANARY"

printf 'const A: &str = "Upgrade \xff\xfe plan";\n' > "$CANARY"
expect "invalid-utf8" "./$GATE" 2 "not valid UTF-8" --surfaces-only
rm -f "$CANARY"

echo "1d3. CONTROL: a properly closed NESTED block comment must still scan fine."
# Otherwise 1d2 would pass against an extractor that simply rejected all block comments.
printf '/* outer /* inner */ still comment */\nfn canary() {}\n' > "$CANARY"
expect "nested-comment-ok" "./$GATE" 0 "PASS: commercial UI surface" --surfaces-only
rm -f "$CANARY"

echo "1e. A comment must NOT be mistaken for rendered UI."
# The counterpart control: the extractor must be capable of NOT matching, or "it flags
# everything" would masquerade as thorough coverage.
printf '// Warp Drive and Sign in appear only in this comment\nfn canary() {}\n' > "$CANARY"
expect "comment-not-ui" "./$GATE" 0 "PASS: commercial UI surface" --surfaces-only
rm -f "$CANARY"

echo "1f. A path the record format cannot encode must fail closed, not be skipped."
ODD_DIR="$(mktemp -d app/src/__gate_selftest_XXXXXX)"
printf 'fn x() -> &%sstatic str { "Warp Drive" }\n' "'" > "$ODD_DIR/od:\"quote.rs"
expect "colon-quote-path" "./$GATE" 1 "adds commercial UI surfaces" --surfaces-only
rm -rf "$ODD_DIR"; ODD_DIR=""

echo "2. --update must REFUSE to baseline an addition without --allow-additions."
printf 'fn canary() -> &%sstatic str { "Manage billing" }\n' "'" > "$CANARY"
expect "update-refuses-additions" "./$GATE" 1 "refuses to baseline ADDED" --update
rm -f "$CANARY"
cp "$BACKUP" "$BASELINE"

echo "2b. CONTROL: --update on an unchanged tree must SUCCEED."
# Without this, case 2 would still 'pass' if --update were broken outright and always failed.
expect "control-update-clean" "./$GATE" 0 "Recorded" --update
cp "$BACKUP" "$BASELINE"

echo "3. A REMOVED surface must force a re-record rather than passing quietly."
printf 'app/src/nonexistent_phantom.rs:warp drive\n' >> "$BASELINE"
LC_ALL=C sort -o "$BASELINE" "$BASELINE"
expect "stale-baseline" "./$GATE" 3 "baseline is now stale" --surfaces-only
cp "$BACKUP" "$BASELINE"

echo "4. A missing baseline must not let --update bless the whole tree silently."
MOVED="$(mktemp)"; SCRATCH+=("$MOVED")
mv "$BASELINE" "$MOVED" || { echo "  FAIL: could not move baseline aside"; failures=$((failures+1)); }
expect "bootstrap-needs-consent" "./$GATE" 1 "would bless every surface" --update

echo "4b. CONTROL: with the baseline absent, an EXPLICIT bootstrap must SUCCEED."
# Without this, case 4 would still 'pass' against an implementation that rejects bootstrapping
# unconditionally -- refusing everything is not the same as requiring consent.
expect "control-bootstrap" "./$GATE" 0 "Bootstrapped" --update --allow-additions
cp "$MOVED" "$BASELINE" || { echo "  FAIL: could not restore baseline"; failures=$((failures+1)); }

echo "5. The collector must read the WHOLE tree, not a familiar subset of it."
# Raising MIN_RS_TOTAL only exercises the file-count floor, which says nothing about the
# collector's reach: a regression that scanned just app/src would satisfy every other case
# here, and would do so most convincingly at the empty-baseline end state this sweep is aiming
# for. So plant a real marker in a crate far outside the directories the gate used to name, and
# require the gate to find it.
REMOTE_DIR="$(mktemp -d crates/warp_util/src/__gate_selftest_XXXXXX)" || {
  echo "  FAIL [whole-tree-coverage]: could not allocate a directory outside app/src"
  failures=$((failures + 1)); REMOTE_DIR=""; }
if [[ -n "$REMOTE_DIR" ]]; then
  printf 'fn canary() -> &%sstatic str { "Compare plans" }\n' "'" > "$REMOTE_DIR/canary.rs"
  expect "whole-tree-coverage" "./$GATE" 1 "adds commercial UI surfaces" --surfaces-only
  rm -rf "$REMOTE_DIR"; REMOTE_DIR=""
fi

echo "6. A scan that walked almost nothing must fail closed."
# CONTROL FIRST: an unmodified copy at this same path must PASS. Without it, this case would
# still 'succeed' if the sed silently stopped matching -- exactly how the original version of
# this suite fooled itself.
CONTROL="$(mktemp script/heddle/.gate-selftest-XXXXXX)"; SCRATCH+=("$CONTROL")
cp "$GATE" "$CONTROL" && chmod +x "$CONTROL"
expect "control-unmodified-copy" "./$CONTROL" 0 "PASS: commercial UI surface" --surfaces-only

MUTANT="$(mktemp script/heddle/.gate-selftest-XXXXXX)"; SCRATCH+=("$MUTANT")
sed 's/^MIN_RS_TOTAL=2000$/MIN_RS_TOTAL=999999/' "$GATE" > "$MUTANT"
if ! grep -q 'MIN_RS_TOTAL=999999' "$MUTANT"; then
  echo "  FAIL [truncated-scan]: the substitution did not apply; this case would be vacuous."
  failures=$((failures + 1))
else
  chmod +x "$MUTANT"
  expect "truncated-scan" "./$MUTANT" 2 "expected >=" --surfaces-only
fi

echo "7. A missing toolchain must be infrastructure (2), not a compile failure (1)."
# Not hypothetical: the gate's first run had no cargo on PATH, exited 127, and announced "the
# GUI does not compile" while printing no errors, because there were none.
#
# Two controls, because the bare assertion is satisfiable by any infrastructure failure at all:
# cargo must actually BE on the normal PATH, and must actually be ABSENT from the reduced one.
# Otherwise this case keeps passing on a machine with no Rust installed, proving nothing about
# the gate's ability to tell the two apart.
#
# The absence check runs `command` inside /bin/sh: `command` is a shell builtin, so
# `env PATH=... command -v cargo` would look for an EXTERNAL binary named `command`, fail to
# find one, and report cargo absent without ever having looked for cargo.
if ! command -v cargo >/dev/null; then
  echo "  FAIL [missing-toolchain]: cargo is not on PATH, so this case cannot prove anything."
  failures=$((failures + 1))
elif env PATH=/usr/bin:/bin /bin/sh -c 'command -v cargo >/dev/null'; then
  echo "  FAIL [missing-toolchain]: cargo is reachable from the reduced PATH; case is vacuous."
  failures=$((failures + 1))
else
  out="$(env PATH=/usr/bin:/bin "./$GATE" 2>&1)"; status=$?
  # Demand the specific evidence -- cargo exit 127 -- not merely the word "infrastructure",
  # which any other infrastructure failure would also produce.
  if [[ "$status" -ne 2 ]]; then
    echo "  FAIL [missing-toolchain]: expected exit 2, got $status"
    failures=$((failures + 1))
  elif ! printf '%s' "$out" | grep -qF "cargo exit 127"; then
    echo "  FAIL [missing-toolchain]: exit 2, but not for a missing cargo (want 'cargo exit 127')"
    printf '%s' "$out" | sed 's/^/    /' | head -6
    failures=$((failures + 1))
  else
    echo "  ok [missing-toolchain]: exit 2, reported as cargo exit 127"
  fi
fi

echo
if [[ "$failures" -ne 0 ]]; then
  echo "SELF-TEST FAILED: $failures case(s). A gate that cannot be shown to fail is not evidence."
  exit 1
fi
echo "All gui-surface-gate self-tests passed."
