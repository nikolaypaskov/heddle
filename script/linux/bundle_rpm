#!/usr/bin/env bash
#
# Builds a .rpm package as part of the bundling process.
#
# Required environment variables:
#   - WORKSPACE_ROOT_DIR: The root directory of the Cargo workspace.
#   - DIST_DIR: A temporary directory we can use for staging files as we build the package.
#   - OUT_DIR: The directory into which we should place the final package.
#   - CARGO_TARGET_OUTPUT_DIR: The cargo target directory containing build output.
#   - RELEASE_CHANNEL: The release channel we're bundling (e.g.: "dev").
#   - BUNDLE_ID: The app ID for the bundle (e.g.: "dev.warp.WarpDev").
#   - EXECUTABLE_PATH: The path to the compiled executable we want to install.
#   - BINARY_NAME: The name that the compiled executable should have on the target machine.
#   - ARTIFACT: Which artifact to build: app or cli.

set -e

# Extract channel suffix from BINARY_NAME
if [ "$ARTIFACT" = "cli" ]; then
  CHANNEL_SUFFIX="${BINARY_NAME#oz}"
else
  CHANNEL_SUFFIX="${BINARY_NAME#warp}"
fi
REPO_NAME="warpdotdev$CHANNEL_SUFFIX"

# On Linux, we keep the `-stable` suffix for stable to avoid package conflicts.
# The binary name is still `oz`, and the repo name is still `warpdotdev`.
if [ "$ARTIFACT" = "cli" -a "$RELEASE_CHANNEL" = "stable" ]; then
  CHANNEL_SUFFIX="-stable"
fi

ARTIFACT="${ARTIFACT:-app}"

# The OSS channel is Heddle. Same reasoning as the matching branch in
# script/linux/bundle_deb and script/linux/bundle_appimage: BINARY_NAME is
# "heddle", so `${BINARY_NAME#warp}` strips nothing and the generic path would
# name the package "warp-terminalheddle", install it under /opt/warpdotdev/,
# stamp Warp's vendor on it, and configure Warp's rpm repository on the user's
# machine. AGPL grants the code, not the trademark, and this fork hosts no
# repository to point anyone at.
#
# SIGN_PACKAGE is the other half. Below, the non-oss path imports a public key
# from a warp.dev URL and signs with a warp.dev key id. This fork has neither the
# key nor any reason to reach that host during a release build.
if [ "$RELEASE_CHANNEL" = "oss" ]; then
  if [ "$ARTIFACT" != "app" ]; then
    echo "::error ::The oss channel only builds the 'app' artifact, got '$ARTIFACT'"
    exit 1
  fi
  PACKAGE_NAME="heddle"
  SPEC_TEMPLATE="$WORKSPACE_ROOT_DIR/resources/linux/rpm/heddle/heddle.spec.template"
  SIGN_PACKAGE="false"
elif [ "$ARTIFACT" = "app" ]; then
  PACKAGE_NAME="warp-terminal$CHANNEL_SUFFIX"
  SPEC_TEMPLATE="$WORKSPACE_ROOT_DIR/resources/linux/rpm/app/warp.spec.template"
  SIGN_PACKAGE="true"
elif [ "$ARTIFACT" = "cli" ]; then
  PACKAGE_NAME="oz$CHANNEL_SUFFIX"
  SPEC_TEMPLATE="$WORKSPACE_ROOT_DIR/resources/linux/rpm/cli/warp.spec.template"
  SIGN_PACKAGE="true"
else
  echo "::error ::Unknown ARTIFACT: $ARTIFACT (expected 'app' or 'cli')"
  exit 1
fi

BUILD_ARCH="${BUILD_ARCH:-$(uname -m)}"
if [ "$BUILD_ARCH" = "aarch64" ]; then
  ARCH="aarch64"
else
  ARCH="x86_64"
fi

RPMBUILD_DIR="$DIST_DIR/rpmbuild"

FULL_PACKAGE_NAME="$PACKAGE_NAME-$ARCH"
PKGDIR="$DIST_DIR/rpmpkg/$FULL_PACKAGE_NAME"

cleanup() {
  # Delete the rpmbuild directory where the build took place.
  if [ -d "$RPMBUILD_DIR" ]; then
    rm -rf "$RPMBUILD_DIR"
  fi
}

# Run cleanup() when the script terminates (whether it succeeded or failed).
trap cleanup EXIT

# Construct a directory that contains the build tree.
#
# BUILD/BUILDROOT/SOURCES/SRPMS are created explicitly, which only SPEC and RPMS
# were before. rpmbuild's %install prologue does `cd %{_builddir}` before it runs
# anything from the spec, so a _topdir with no BUILD/ under it would fail before
# the spec was ever reached. Tested both ways in a container: rpm 4.18.2 (Ubuntu
# 24.04) and 4.20.1 (Fedora 41) create the directories themselves and build fine
# without this line, so it is insurance against an rpm that does not, not a fix
# for a failure seen here.
rm -rf "$RPMBUILD_DIR"
mkdir -p "$RPMBUILD_DIR"/{SPEC,RPMS,BUILD,BUILDROOT,SOURCES,SRPMS}

# Move the RPM-specific package metadata into the package directory.
#
# The leading "v" is stripped for the oss channel, matching what
# script/linux/bundle_deb does with the same variable. GIT_RELEASE_TAG is
# "vX.Y.Z" (the APP version, derived from the git tag by the release workflow --
# see .github/workflows/heddle-release.yml, and do not change that derivation).
# RPM compares versions segment by segment, and a leading letter makes "v0.10.0"
# sort before "v0.9.0"; a package that cannot be upgraded by its own version
# numbering is a defect that only shows up two releases later. The same string
# goes into the spec and into the predicted file name below, so the two cannot
# disagree.
if [ "$RELEASE_CHANNEL" = "oss" ]; then
  VERSION="${GIT_RELEASE_TAG#v}"
else
  VERSION="$GIT_RELEASE_TAG"
fi
RELEASE="1"
sed \
    "s#@@CHANNEL_SUFFIX@@#$CHANNEL_SUFFIX#g; \
     s#@@PACKAGE_NAME@@#$PACKAGE_NAME#g; \
     s#@@BINARY_NAME@@#$BINARY_NAME#g; \
     s#@@VERSION@@#$VERSION#g; \
     s#@@RELEASE@@#$RELEASE#g; \
     s#@@ARCH@@#$ARCH#g; \
     s#@@WORKSPACEROOT@@#$WORKSPACE_ROOT_DIR#g; \
     s#@@BUNDLEID@@#$BUNDLE_ID#g; \
     s#@@REPO_NAME@@#$REPO_NAME#g; \
     s#@@RELEASE_CHANNEL@@#$RELEASE_CHANNEL#g" \
    < "$SPEC_TEMPLATE" \
    > "$RPMBUILD_DIR/SPEC/$PACKAGE_NAME.spec"

# A package that declares nothing installs cleanly and then fails to start.
# See the matching check in script/linux/bundle_deb for the full reasoning; the
# short version is that libasound.so.2 is a hard requirement of the GUI feature
# (crates/voice_input -> cpal, non-optional, reached through `gui`), and a clean
# ubuntu:24.04 could not run the v0.5.0 binary without it. Checked against the
# rendered spec, because an unsubstituted placeholder or an edited template both
# produce a spec rpmbuild accepts in silence.
if ! grep -qE '^Requires:[[:space:]]*[^[:space:]]' "$RPMBUILD_DIR/SPEC/$PACKAGE_NAME.spec"; then
  echo "::error ::$RPMBUILD_DIR/SPEC/$PACKAGE_NAME.spec declares no Requires line"
  exit 1
fi
if ! grep -qE '^Requires:.*(libasound|alsa)' "$RPMBUILD_DIR/SPEC/$PACKAGE_NAME.spec"; then
  echo "::error ::$RPMBUILD_DIR/SPEC/$PACKAGE_NAME.spec does not declare an ALSA dependency"
  exit 1
fi

# Build the actual package.
fakeroot rpmbuild -v -bb "$RPMBUILD_DIR/SPEC/$PACKAGE_NAME.spec" --target="$ARCH" --define "_topdir $RPMBUILD_DIR"

# Copy the package to the output directory.
#
# rpmbuild names the file from Name/Version/Release/arch in the spec, so this is
# a PREDICTION. Check it rather than letting `cp` report a bare "no such file":
# script/linux/bundle_appimage grew the same check for the same reason.
RPM_NAME="$PACKAGE_NAME-$VERSION-$RELEASE.$ARCH.rpm"
if [ ! -f "$RPMBUILD_DIR/RPMS/$ARCH/$RPM_NAME" ]; then
  echo "ERROR: rpmbuild did not produce $RPM_NAME." >&2
  echo "       Found in $RPMBUILD_DIR/RPMS/$ARCH:" >&2
  ls -1 "$RPMBUILD_DIR/RPMS/$ARCH" >&2 || true
  exit 1
fi
cp "$RPMBUILD_DIR/RPMS/$ARCH/$RPM_NAME" "$OUT_DIR"

# If we're running on GitHub, sign the package using our signing key that
# should have already been added to the gpg-agent with a preset passphrase.
if [ "$SIGN_PACKAGE" == "true" ] && [ "${GITHUB_ACTIONS}" == "true" ]; then
  # Import our signing key's public key into rpm so the signature can be
  # verified.
  sudo rpm --import https://releases.warp.dev/linux/keys/warp.asc

  # We use batch mode with tty-based pin entry to ensure that the build doesn't
  # hang waiting on user input if, for some reason, we failed to preset the
  # passphrase for the signing key in the gpg-agent cache.
  #
  # Additionally, until we know that this works, don't let an error here fail
  # the build.
  rpmsign \
    --verbose \
    --addsign --key-id "linux-maintainers@warp.dev" \
    --define "_gpg_sign_cmd_extra_args --batch --yes --pinentry-mode loopback" --define "_gpg_digest_algo sha256" \
    "$OUT_DIR/$RPM_NAME" \
    || true
fi

# Hand the exact path to the release workflow rather than making it guess with a
# glob. Same mechanism script/linux/bundle_appimage uses for appimage_path.
if [ "${GITHUB_ACTIONS:-}" == "true" ]; then
  echo "::echo::on"
  echo "rpm_path=$OUT_DIR/$RPM_NAME" >> "$GITHUB_OUTPUT"
  echo "::echo::off"
fi

echo "Successfully built .rpm package at $OUT_DIR/$RPM_NAME!"
