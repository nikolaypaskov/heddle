#!/usr/bin/env bash
#
# Builds a .deb package as part of the bundling process.
#
# Required environment variables:
#   - WORKSPACE_ROOT_DIR: The root directory of the Cargo workspace.
#   - DIST_DIR: A temporary directory we can use for staging files as we build the package.
#   - OUT_DIR: The directory into which we should place the final package.
#   - CARGO_TARGET_OUTPUT_DIR: The cargo target directory containing build output.
#   - RELEASE_CHANNEL: The release channel we're bundling (e.g.: "dev").
#   - BUNDLE_ID: The app ID for the bundle (e.g.: "dev.warp.WarpDev").
#   - EXECUTABLE_PATH: The path to the compiled executable we want to install.
#   - BINARY_NAME: The name that the compiled executable should have on the target machine.
#   - ARTIFACT: Which artifact to build: app or cli.

set -e

# Extract channel suffix from BINARY_NAME
if [ "$ARTIFACT" = "cli" ]; then
  CHANNEL_SUFFIX="${BINARY_NAME#oz}"
else
  CHANNEL_SUFFIX="${BINARY_NAME#warp}"
fi
REPO_NAME="warpdotdev$CHANNEL_SUFFIX"

# On Linux, we keep the `-stable` suffix for stable to avoid package conflicts.
# The binary name is still `oz`, and the repo name is still `warpdotdev`.
if [ "$ARTIFACT" = "cli" -a "$RELEASE_CHANNEL" = "stable" ]; then
  CHANNEL_SUFFIX="-stable"
fi

# The OSS channel is Heddle, and three USER-VISIBLE things change with it: the
# package name, the /opt provider directory, and the control/maintainer-script
# templates.
#
# Without this branch the generic path below is not merely mis-branded, it is
# broken: BINARY_NAME is "heddle", so `${BINARY_NAME#warp}` strips nothing, and
# the package would be called "warp-terminalheddle" and install itself under
# /opt/warpdotdev/. script/linux/bundle_appimage has carried the identical branch
# and the identical explanation since the AppImage was first built here; this one
# was simply never written, because no channel had ever asked this fork for a
# .deb. AGPL grants the code, not the trademark.
#
# CONFIGURE_PACKAGE_REPO is the other half. Every other channel appends
# resources/linux/debian/common/postinst.repo.template, which installs a
# package-signing key and writes an apt source list. This fork publishes to
# GitHub Releases and hosts no apt repository, so that source would 404 on every
# `apt update` for every user who installed the package.
if [ "$RELEASE_CHANNEL" = "oss" ]; then
  if [ "$ARTIFACT" != "app" ]; then
    echo "::error ::The oss channel only builds the 'app' artifact, got '$ARTIFACT'"
    exit 1
  fi
  PACKAGE_NAME="heddle"
  OPT_PROVIDER="heddle"
  TEMPLATE_DIR="$WORKSPACE_ROOT_DIR/resources/linux/debian/heddle"
  CONFIGURE_PACKAGE_REPO="false"
else
  OPT_PROVIDER="warpdotdev"
  CONFIGURE_PACKAGE_REPO="true"
  case "$ARTIFACT" in
    app)
      PACKAGE_NAME="warp-terminal$CHANNEL_SUFFIX"
      ;;
    cli)
      PACKAGE_NAME="oz$CHANNEL_SUFFIX"
      ;;
    *)
      echo "::error ::Unknown ARTIFACT: $ARTIFACT (expected 'app' or 'cli')"
      exit 1
      ;;
  esac
  TEMPLATE_DIR="$WORKSPACE_ROOT_DIR/resources/linux/debian/$ARTIFACT"
fi

# Add a simple test to make sure we're generating the appropriate repository
# name for the stable channel.
if [ "$RELEASE_CHANNEL" = "stable" ]; then
  if [ "$REPO_NAME" != "warpdotdev" ]; then
    echo "::error ::Unexpected repo name for $RELEASE_CHANNEL channel: $REPO_NAME (expected \"warpdotdev\")"
    exit 1
  fi
fi

BUILD_ARCH="${BUILD_ARCH:-$(uname -m)}"
if [ "$BUILD_ARCH" = "aarch64" ]; then
  ARCH="arm64"
else
  ARCH="amd64"
fi

FULL_PACKAGE_NAME="$PACKAGE_NAME-$ARCH"
PKGDIR="$DIST_DIR/debpkg/$FULL_PACKAGE_NAME"

cleanup() {
  # Delete the AppDir that was used as a staging area during the bundling
  # process.
  if [ -d "$PKGDIR" ]; then
    rm -rf "$PKGDIR"
  fi
}

# Run cleanup() when the script terminates (whether it succeeded or failed).
trap cleanup EXIT

# Construct a directory that contains all of the output data.
rm -rf "$PKGDIR"
mkdir -p "$PKGDIR"

# Populate the directory with the package contents, in the appropriate
# locations.
OPT_DIR="/opt/$OPT_PROVIDER/$PACKAGE_NAME"
source "$WORKSPACE_ROOT_DIR/script/linux/bundle_install" "$PKGDIR"

# Ship the /usr/bin symlink IN THE DATA ARCHIVE, not from the postinst.
#
# The postinst used to `rm -f /usr/bin/heddle` and then `ln -s` it. That creates
# a path dpkg does not own, and three things follow from that:
#
#   1. dpkg runs no conflict check, because as far as it knows the package
#      installs nothing at /usr/bin/heddle. Another package's file there is
#      deleted silently by the `rm -f`.
#   2. `dpkg -L heddle` never lists it and `dpkg -S /usr/bin/heddle` reports
#      nothing owns it, so a later package can take the path with no conflict
#      recorded anywhere.
#   3. `postrm`'s matching unconditional `rm -f` then deletes whatever is at
#      that path on removal -- including the file that other package installed.
#
# Packaging the link fixes all three: dpkg refuses to overwrite a path another
# package owns, records ownership, and on removal deletes only what it installed
# and only while the record still points at us.
#
# resources/linux/rpm/heddle/heddle.spec.template already did this correctly --
# it creates the link in %install and lists it in %files. This is the .deb
# catching up with the .rpm.
#
# Absolute, not relative: Debian policy asks for relative symlinks within one
# top-level directory and absolute ones across, and /usr/bin -> /opt crosses.
#
# oss only. The other channels' postinst templates still manage the link
# themselves; changing that would change packages this fork does not ship.
if [ "$RELEASE_CHANNEL" = "oss" ]; then
  mkdir -p "$PKGDIR/usr/bin"
  ln -s "$OPT_DIR/$BINARY_NAME" "$PKGDIR/usr/bin/$BINARY_NAME"
fi

# Move the Debian-specific package metadata into the package directory.
DEBIAN_DIR="$PKGDIR/DEBIAN"
VERSION="$(echo "$GIT_RELEASE_TAG" | sed -E "s/^v//; s/([a-z]+)_/\1./")"
mkdir "$DEBIAN_DIR"
sed \
    "s#@@CHANNEL_SUFFIX@@#$CHANNEL_SUFFIX#g; s#@@PACKAGE_NAME@@#$PACKAGE_NAME#g; s#@@VERSION@@#$VERSION#g; s#@@ARCH@@#$ARCH#g" \
    < "$TEMPLATE_DIR/control.template" \
    > "$DEBIAN_DIR/control"
sed \
    "s#@@CHANNEL_SUFFIX@@#$CHANNEL_SUFFIX#g; s#@@BINARY_NAME@@#$BINARY_NAME#g; s#@@OPTDIR@@#$OPT_DIR#g; s#@@REPO_NAME@@#$REPO_NAME#g; s#@@CHANNEL@@#$RELEASE_CHANNEL#g; s#@@ARCH@@#$ARCH#g" \
    < "$TEMPLATE_DIR/postinst.template" \
    > "$DEBIAN_DIR/postinst"
if [ "$CONFIGURE_PACKAGE_REPO" = "true" ]; then
  sed \
      "s#@@REPO_NAME@@#$REPO_NAME#g; s#@@CHANNEL@@#$RELEASE_CHANNEL#g; s#@@ARCH@@#$ARCH#g" \
      < "$WORKSPACE_ROOT_DIR/resources/linux/debian/common/postinst.repo.template" \
      >> "$DEBIAN_DIR/postinst"
fi
sed \
    "s#@@CHANNEL_SUFFIX@@#$CHANNEL_SUFFIX#g; s#@@BINARY_NAME@@#$BINARY_NAME#g; s#@@OPTDIR@@#$OPT_DIR#g; s#@@REPO_NAME@@#$REPO_NAME#g" \
    < "$TEMPLATE_DIR/postrm.template" \
    > "$DEBIAN_DIR/postrm"
if [ "$CONFIGURE_PACKAGE_REPO" = "true" ]; then
  sed \
      "s#@@REPO_NAME@@#$REPO_NAME#g" \
      < "$WORKSPACE_ROOT_DIR/resources/linux/debian/common/postrm.repo.template" \
      >> "$DEBIAN_DIR/postrm"
fi

# Make the package scripts executable.
chmod 755 \
    "$DEBIAN_DIR/postinst" \
    "$DEBIAN_DIR/postrm"

# A package that declares nothing fails exactly the way a bare binary does, only
# later and more confusingly: apt reports a successful install and the program
# then dies with "libasound.so.2: cannot open shared object file". Verified in a
# clean ubuntu:24.04 container against the shipped v0.5.0 build.
#
# ALSA is the one library on the binary's DT_NEEDED list that a minimal system
# does not already have. It arrives through crates/voice_input -> cpal, which is
# a NON-OPTIONAL dependency, and app/Cargo.toml declares `gui = ["voice_input"]`,
# so it is a hard component of the GUI rather than an optional extra. Dropping it
# would mean dropping voice input from Linux; bundling libasound is also wrong
# (it is on the AppImage excludelist deliberately, because audio libraries are
# meant to match the host). Declaring it is the answer.
#
# `libasound2t64 | libasound2`, in that order: the 64-bit-time_t transition
# renamed the package on Debian trixie / Ubuntu 24.04 and later. apt takes the
# first installable alternative, so new releases resolve the t64 name and older
# ones (bookworm, jammy) fall through to the historical one.
#
# Checked here rather than trusted from the template, because a sed that failed
# to substitute, or a template edited to drop the line, both produce a control
# file that dpkg-deb accepts without complaint.
#
# Matched EXACTLY, not by substring. A test for "libasound" anywhere in the line
# would accept `libasound-does-not-exist`, which dpkg-deb builds happily and apt
# then refuses on the user's machine. The release workflow additionally resolves
# the whole field with `apt-get install -s` against a real apt index; this check
# is the build-time half, and it runs even for a local `./script/bundle` where
# there is no workflow to do the resolving.
DEPENDS_LINE="$(sed -n 's/^Depends:[[:space:]]*//p' "$DEBIAN_DIR/control")"
if [ -z "$DEPENDS_LINE" ]; then
  echo "::error ::$DEBIAN_DIR/control declares no Depends line; the package would install and then fail to start"
  exit 1
fi
# The ALSA assertion is oss-only. Warp's control.template does not list it and is
# not this fork's to change; asserting it unconditionally would fail a build of a
# channel we do not ship, for a rule we do not get to impose.
if [ "$RELEASE_CHANNEL" = "oss" ]; then
  DEB_ALSA_DEPENDS="libasound2t64 | libasound2"
  case "$DEPENDS_LINE" in
    *"$DEB_ALSA_DEPENDS"*) ;;
    *)
      echo "::error ::$DEBIAN_DIR/control does not declare '$DEB_ALSA_DEPENDS'; got: $DEPENDS_LINE"
      exit 1
      ;;
  esac
fi

# Build the actual package.
cd "$DIST_DIR/debpkg"
fakeroot dpkg-deb -b "$PACKAGE_NAME-$ARCH" "$OUT_DIR"

# dpkg-deb names the output from the control file, not from the directory it was
# given, so the name below is a PREDICTION and has to be checked. The same class
# of mistake in script/linux/bundle_appimage is why that script grew an existence
# check: a name nothing downstream looks for uploads an empty set and reports
# success.
DEB_PATH="$OUT_DIR/${PACKAGE_NAME}_${VERSION}_${ARCH}.deb"
if [ ! -f "$DEB_PATH" ]; then
  echo "ERROR: dpkg-deb did not produce $DEB_PATH." >&2
  echo "       Found in $OUT_DIR:" >&2
  ls -1 "$OUT_DIR" >&2
  exit 1
fi

# Hand the exact path to the release workflow rather than making it guess with a
# glob. Same mechanism script/linux/bundle_appimage uses for appimage_path.
if [ "${GITHUB_ACTIONS:-}" == "true" ]; then
  echo "::echo::on"
  echo "deb_path=$DEB_PATH" >> "$GITHUB_OUTPUT"
  echo "::echo::off"
fi

echo "Successfully built .deb package at $DEB_PATH!"
