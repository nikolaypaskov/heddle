#!/bin/bash
#
# linuxdeploy input plugin for restructuring the AppDir to match the standard
# Linux install layout.
#
# The file name is a linuxdeploy contract, not branding: `--plugin NAME` is
# resolved by searching the PATH for `linuxdeploy-plugin-NAME`, so this name and
# the flag in script/linux/bundle_appimage must agree. Same for the WARP_*
# variables below -- they are the private calling convention between these two
# scripts and appear nowhere a user can see. The names that DO ship (the
# package directory, the /opt provider, the desktop Exec=) are set per channel
# in bundle_appimage.
#
# By default, linuxdeploy places the executable at usr/bin/ inside the AppDir.
# This plugin moves it to the install directory (matching deb/rpm/arch package
# layout), creates a symlink from usr/bin/ to the new location, and copies
# bundled resources alongside the binary.
#
# This means that extracting an AppImage produces the same filesystem layout
# as installing a .deb or .rpm package.
#
# Required environment variables:
#   WARP_BINARY_NAME:           Name of the binary (e.g. "heddle", "warp-dev").
#   WARP_OPT_DIR:               Absolute install directory INSIDE the image, e.g.
#                               "/opt/heddle/heddle" or "/opt/warpdotdev/warp-terminal-dev".
#                               Passed in rather than rebuilt here so the AppDir
#                               layout cannot drift from the staged one.
#   WARP_BUNDLED_RESOURCES_DIR: Path to the staged resources directory to copy.

set -e

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --plugin-api-version)
      echo "0"
      exit 0
      ;;
    --appdir)
      APPDIR="$2"
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done

if [ -z "$APPDIR" ]; then
  echo "ERROR: --appdir is required" >&2
  exit 1
fi

for var in WARP_BINARY_NAME WARP_OPT_DIR WARP_BUNDLED_RESOURCES_DIR; do
  if [ -z "${!var}" ]; then
    echo "ERROR: $var environment variable is not set" >&2
    exit 1
  fi
done

# The symlink built below walks up exactly two levels (from usr/bin/ to the
# AppDir root) and then follows WARP_OPT_DIR, so a relative value would produce
# a link pointing outside the image.
case "$WARP_OPT_DIR" in
  /*) ;;
  *)
    echo "ERROR: WARP_OPT_DIR must be an absolute in-image path, got '$WARP_OPT_DIR'" >&2
    exit 1
    ;;
esac

if [ ! -d "$WARP_BUNDLED_RESOURCES_DIR" ]; then
  echo "ERROR: Bundled resources directory does not exist: $WARP_BUNDLED_RESOURCES_DIR" >&2
  exit 1
fi

SRC_BIN="$APPDIR/usr/bin/$WARP_BINARY_NAME"
if [ ! -f "$SRC_BIN" ]; then
  echo "ERROR: Expected binary not found at $SRC_BIN" >&2
  exit 1
fi

# Create the install directory inside the AppDir.
OPT_DIR="$APPDIR$WARP_OPT_DIR"
mkdir -p "$OPT_DIR"

# Move the binary from usr/bin/ to the install directory.
echo "Relocating binary to $OPT_DIR/$WARP_BINARY_NAME"
mv "$SRC_BIN" "$OPT_DIR/$WARP_BINARY_NAME"

# Create a relative symlink so usr/bin/<name> still resolves to the binary.
# usr/bin/ is two levels below the AppDir root, so `../..` lands there and
# WARP_OPT_DIR (absolute, in-image) continues from it.
echo "Creating symlink at usr/bin/$WARP_BINARY_NAME"
ln -s "../..$WARP_OPT_DIR/$WARP_BINARY_NAME" "$SRC_BIN"

# Copy bundled resources alongside the binary.
DEST_RESOURCES="$OPT_DIR/resources"
echo "Copying bundled resources to $DEST_RESOURCES"
mkdir -p "$DEST_RESOURCES"
cp -R "$WARP_BUNDLED_RESOURCES_DIR/." "$DEST_RESOURCES/"

echo "Successfully restructured AppDir ($WARP_OPT_DIR/$WARP_BINARY_NAME)"
